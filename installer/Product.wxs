<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Activity Monitor" Manufacturer="Activity Monitor" Version="1.3.2.0"
           UpgradeCode="6f1c2d8a-3b54-4e0a-9a0e-5d2b7c41a9e3" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Activity Monitor is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="ActivityMonitor" />
    </StandardDirectory>

    <Component Id="MainComponent" Directory="INSTALLFOLDER" Guid="a3d5e7f1-2c4b-4a6d-8e90-1b2c3d4e5f60">
      <File Id="AppExe" Source="target\release\ActivityMonitor.exe" KeyPath="no" />
      <!-- start with Windows (per user) -->
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="ActivityMonitor"
                     Type="string" Value="&quot;[INSTALLFOLDER]ActivityMonitor.exe&quot;" KeyPath="yes" />
      <!-- Start menu entry (per user) -->
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Activity Monitor" Description="Taskbar CPU, memory, disk, network and GPU meters" Target="[INSTALLFOLDER]ActivityMonitor.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
    </Component>
    <Feature Id="Main" Title="Activity Monitor" Level="1">
      <ComponentRef Id="MainComponent" />
    </Feature>

    <CustomAction Id="KillApp" Directory="TARGETDIR" ExeCommand="taskkill.exe /F /IM ActivityMonitor.exe" Return="ignore" />
    <CustomAction Id="LaunchApp" FileRef="AppExe" ExeCommand="" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="KillApp" Before="InstallValidate" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
